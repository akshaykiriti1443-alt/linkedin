# ReelVault Members settings (DESIGN-SAAS.md 12.5). PLACEHOLDERS ONLY. Never commit a real .env.
# deploy/setup.sh writes the real file for you (deploy/.env, mode 600) with fresh secrets.
# Keep a copy of your real .env in a password manager: losing RV_MASTER_KEYS means members re-enter their AI keys.

# ---- required
# Your public address (https, no slash at the end).
PUBLIC_URL=https://app.example.com
# Encrypts members' AI keys. Make one with: python -m reelvault.server.security genkey
# Format kid:base64(32 bytes); a comma list rotates keys (the first one is current).
RV_MASTER_KEYS=k1:REPLACE_WITH_OUTPUT_OF_GENKEY

# ---- first admin (created on first start when no admin exists yet)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# ---- docker compose (used by docker-compose.yml and Caddy)
# The domain Caddy gets an HTTPS certificate for (same host as PUBLIC_URL).
RV_DOMAIN=app.example.com
# "https" starts Caddy. Leave empty when a platform or tunnel gives you HTTPS.
COMPOSE_PROFILES=https
# Two containers (web + worker) instead of one: COMPOSE_FILE=docker-compose.yml:docker-compose.split.yml
COMPOSE_FILE=docker-compose.yml

# ---- where data lives (inside the container; the volume is mounted there)
DATA_DIR=/data
# Empty = SQLite at /data/db/reelvault.sqlite (the default). Postgres:
# DATABASE_URL=postgresql+psycopg://reelvault:REPLACE_ME@postgres:5432/reelvault
DATABASE_URL=
# Only with the postgres profile (COMPOSE_PROFILES=https,postgres):
POSTGRES_PASSWORD=

# ---- network
# Proxies whose X-Forwarded-For is trusted (Caddy on the compose network). See hosts/*.md for PaaS values.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# ---- email (optional: pending-signup notices, "You're in", password reset emails). Pick ONE.
# SMTP_URL=smtp://USER:PASSWORD@smtp.example.com:587      (smtps://...:465 for TLS)
SMTP_URL=
# RESEND_API_KEY=re_REPLACE_ME
RESEND_API_KEY=
# MAIL_FROM=ReelVault <no-reply@app.example.com>
MAIL_FROM=

# ---- Zapier hooks (optional): the secret Zapier sends in the X-Hook-Secret header
SKOOL_HOOK_SECRET=

# ---- work sizing (defaults fit most hosts; run `python -m reelvault.server.bench` to measure yours)
# WHISPER_CONCURRENCY=2        # media lanes; default = CPUs / 2
# SERVER_MEDIA_PER_DAY=2400    # reels per day for all members; default = CPUs x 1,200
AI_CONCURRENCY=6
LIGHT_CONCURRENCY=2
WHISPER_MODEL=small
WHISPER_SAMPLE_MODEL=base
SERVER_CDN_FETCH=1
SFX_FLOOR=0.03
SFX_REL=6

# ---- backups (optional): a command that copies /data/backups off this server after each daily backup
# BACKUP_COPY_CMD=rclone copy /data/backups remote:reelvault-backups
BACKUP_COPY_CMD=

LOG_LEVEL=info
