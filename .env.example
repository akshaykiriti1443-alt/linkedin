# Random string you choose — must match what you enter in Meta developer console
VERIFY_TOKEN=your_random_verify_token

# App Secret from Meta App Dashboard > Settings > Basic
APP_SECRET=your_app_secret

# Instagram Page Access Token with instagram_manage_comments permission
PAGE_ACCESS_TOKEN=your_page_access_token

# The reply that gets posted on every new comment (optional, has a default)
REPLY_TEMPLATE=Thanks for your comment! 🙌 DM me to get the full guide.
